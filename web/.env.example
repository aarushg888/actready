# Base URL for the ActReady backend API. The frontend sends every request as
# `${VITE_API_BASE}<endpoint>` and injects `Authorization: Bearer <jwt>`.
# When developing against the FastAPI backend on its own port, set e.g.:
#   VITE_API_BASE=http://localhost:8000/api
# Leave as `/api` (the default) when serving behind a proxy that routes /api -> backend.
VITE_API_BASE=/api
